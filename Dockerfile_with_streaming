FROM python:3.6
LABEL maintainer="Evgeny Medvedev <evge.medvedev@gmail.com>"
ENV PROJECT_DIR=bitcoin-etl

RUN mkdir /$PROJECT_DIR
WORKDIR /$PROJECT_DIR
COPY . .
RUN pip install --upgrade pip && pip install -e /$PROJECT_DIR/[streaming]

# Add Tini with better error handling and retry logic
ENV TINI_VERSION=v0.18.0
RUN set -ex; \
    apt-get update && apt-get install -y --no-install-recommends curl ca-certificates; \
    curl -fsSL https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini -o /tini; \
    chmod +x /tini; \
    apt-get remove -y curl; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/tini", "--", "python", "bitcoinetl"]
